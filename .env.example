# Default OpenAI-compatible LLM provider configuration.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=replace-with-your-groq-api-key
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=30
MIN_RELEVANCE_SCORE=0.45

# Remote MCP Knowledge Server.
MCP_SERVER_URL=http://localhost:8001/mcp

# Local app settings.
BACKEND_DATABASE_URL=storage/copilot.db
CHROMA_PERSIST_DIR=storage/chroma
HR_POLICY_DATA_DIR=data/hr_policies
HF_HOME=storage/huggingface
VITE_API_BASE_URL=http://localhost:8000

# Optional local overrides.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHROMA_COLLECTION_NAME=hr_policy_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MCP_FEEDBACK_DB=storage/mcp_feedback.db
